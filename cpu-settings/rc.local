#!/bin/sh
PATH=/usr/sbin:/usr/bin:/sbin:/bin

# wait up to ~5 seconds for cpufreq to appear (boot timing)
i=0
while [ ! -d /sys/devices/system/cpu/cpu0/cpufreq ] && [ $i -lt 50 ]; do
  sleep 0.1
  i=$((i+1))
done

cpupower frequency-set -g powersave
cpupower frequency-set -d 2300MHz
cpupower frequency-set -u 3000MHz

exit 0
