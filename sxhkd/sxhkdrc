# launchers
super + q
	alacritty

super + d
	rofi -show drun

super + b
	prime-run firefox

super + e
	pcmanfm


# audio keys
XF86AudioMute
	pamixer --toggle-mute

XF86AudioRaiseVolume
	pamixer -i 2

XF86AudioLowerVolume
	pamixer -d 2


# reload sxhkd
super + Escape
	pkill -USR1 -x sxhkd

# quit/restart bspwm
super + alt + {q,r}
	bspc {quit,wm -r}

# close and kill
super + {_,shift + }c
	bspc node -{c,k}

# focus next/prev window (changed from super+c which conflicted)
super + {n,p}
	bspc node -f {next,prev}.local.!hidden.window


# set window state
super + {t,shift + t,s,f}
	bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# set node flags
super + ctrl + {m,x,y,z}
	bspc node -g {marked,locked,sticky,private}


# focus/swap direction
super + {_,shift + }{h,j,k,l}
	bspc node -{f,s} {west,south,north,east}

# desktops
super + bracket{left,right}
	bspc desktop -f {prev,next}.local

# focus last
super + {grave,Tab}
	bspc {node,desktop} -f last

# send/focus desktop
super + {_,shift + }{1-9,0}
	bspc {desktop -f,node -d} '^{1-9,10}'


# preselect
super + ctrl + {h,j,k,l}
	bspc node -p {west,south,north,east}

super + ctrl + {1-9}
	bspc node -o 0.{1-9}

super + ctrl + space
	bspc node -p cancel


# resize tiled
super + alt + {h,j,k,l}
	bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

super + alt + shift + {h,j,k,l}
	bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# move floating
super + {Left,Down,Up,Right}
	bspc node -v {-20 0,0 20,0 -20,20 0}
